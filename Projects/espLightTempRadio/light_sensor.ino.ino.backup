// Basically the loop ensures that you ESP is connected to your broker and performs all the functions of the broker
void loop() {
  // Connect/reconnect to the broker
  check_connection();

  client.loop();

  // Process smoke detection
  //check_smoke();
  report_smoke_status(false);
  
  // Process temperature and humedity
  now = millis();
  if (now - lastMeasure > dhtTime) {
    lastMeasure = now;
    processHumedityAndTemperature();
  }

  // Process motion detection
  now = millis();
  if (armMotion && motionTriggered) {
    noInterrupts();
    if (motionFirstTimeTriggered) {
      Serial.println("MOTION DETECTED!!!");
      lastMotionTriggered = now;
      client.publish("home/garage/esp1/motion/notification", "MOTION DETECTED");
      motionFirstTimeTriggered = false;
      digitalWrite(motionLED, HIGH);
    } else if (now - lastMotionTriggered > 500) {
        motionTriggered = false;
        client.publish("home/garage/esp1/motion/notification", "NO MOTION");
        digitalWrite(motionLED, LOW);
    }
    interrupts();
  }

  if (now - lastLightMeasure > 500) {
    lastLightMeasure = now;
    processLightMeasurement();
  }

  delay(100);
}

void processLightMeasurement()
{
  int light = analogRead(lightPin);
  Serial.print("Temp read: ");
  Serial.print(light);
  Serial.print("  Normalized: ");

  int m = map(light, 0, 1023, 0, 100);

  Serial.println(m);
  static char lightValTemp[6];
  //dtostrf(m, 6, 0, lightValTemp);
  itoa(m, lightValTemp, 10);
  client.publish("home/garage/esp1/light/value", lightValTemp);

  switch(lightControlMode)
  {
    case 0: 
      if(m <= lightThreshold) {
        if(armMotion) {
          if(lastMotionTriggered){
            Serial.println("Some one moved, turn on lights!");
          } else {
            Serial.println("Keep light off, no one is moving");
          }
        } else {
          Serial.println("It is too dark, turning light on!");
        }
      } else if(m > lightThreshold * 1.1) {
        toggleSwitch(3);
        delay(200);
        toggleSwitch(4);
        Serial.println("It is not dark at all, turning light off!");
      }
      break;
    case 1:
      if(!estimatedLightStatus)
      {
        toggleSwitch(3);
        delay(200);
        toggleSwitch(4);
        Serial.println("Turning light on!");
        estimatedLightStatus = true;
      }
      break;
    case 2:
      if(estimatedLightStatus)
      {
        toggleSwitch(3);
        delay(200);
        toggleSwitch(4);
        Serial.println("Turning light off!");
        estimatedLightStatus = false;
      }
      break;
  }
}

void toggleSwitch(int switchNumber) 
{
  switch(switchNumber)
  {
    case 1:
      mySwitch.send("010001010001010000000011");
      break;
    case 2:
      mySwitch.send("010001010001010000001100");
      break;
    case 3:
      mySwitch.send("010001010001010000110000");
      break;
    case 4:
      mySwitch.send("010001010001010011000000");
      break;
    case 5:
      mySwitch.send("010001010001011100000000");
      break;
  }
}
