// Don't change the function below. This functions connects your ESP8266 to your router
void setup_wifi() {
  delay(10);

  // We start by connecting to a WiFi network
  Serial.println();
  Serial.print("Connecting to ");
  Serial.println(ssid);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  
  Serial.println("");
  Serial.print("WiFi connected - ESP IP address: ");
  Serial.println(WiFi.localIP());
}

// This functions is executed when some device publishes a message to a topic that your ESP8266 is subscribed to
// Change the function below to add logic to your program, so when a device publishes a message to a topic that
// your ESP8266 is subscribed you can actually do something
void callback(String topic, byte* message, unsigned int length) {
  Serial.print("Message arrived on topic: ");
  Serial.print(topic);
  Serial.print(". Message: ");
  String messageTemp;
  for (int i = 0; i < length; i++) {
    Serial.print((char)message[i]);
    messageTemp += (char)message[i];
  }
  
  Serial.println();

  // Feel free to add more if statements to control more GPIOs with MQTT
  // If a message is received on the topic home/office/esp1/desk, you check if the message is either 1 or 0. Turns the Desk outlet according to the message
  if(topic=="home/garage/esp1/switch"){
    //mySwitch.send("010001010001010000000011");
    //mySwitch.send("010001010001010000001100");
      mySwitch.send("010001010001010000110000");
      delay(200);
      mySwitch.send("010001010001010011000000");
    //mySwitch.send("010001010001011100000000");

    Serial.print("Switching light to ");
    if(messageTemp == "1"){
      Serial.println("On");
    }
    else if(messageTemp == "0"){
      Serial.println("Off");
    }
  }
/*
  if(topic=="home/garage/esp1/workbench"){
    Serial.print("Changing Workbench light to ");
    if(messageTemp == "1"){
      mySwitch.send("000101010101010001010101");
      Serial.println("On");
    }
    else if(messageTemp == "0"){
      mySwitch.send("000101010101010001010100");
      Serial.println("Off");
    }
  }*/

  /*
  if(topic=="home/garage/esp1/smoke"){
    Serial.print("SMOKE SENSOR STATUS CHANGE... ");
    if (messageTemp=="Test/Reset") {
      if (smokeTriggered) {
        // Reset
        smokeTriggered = false;
        testMode = false;
        blinkFlag = false;
        blinkStatus = false;
        client.publish("home/garage/esp1/smoke/notification", "NO SMOKE");
        Serial.println("NO SMOKE");
      }
      else 
      {
        // Test
        smokeTriggered = false;
        testMode = true;
        blinkFlag = true;
        blinkStatus = true;
        testModeStart = millis();
        lastBlinkCheck = testModeStart;
        client.publish("home/garage/esp1/smoke/notification", "IN TEST");
        Serial.println("IN TEST");
      }

      blink_smoke(blinkStatus);
    }
  }*/

  if(topic=="home/garage/esp1/motion"){
    Serial.print("MOTION SENSOR STATUS CHANGE...");
    report_motion_status(messageTemp);
  }

  if(topic=="home/garage/esp1/light") {
    Serial.print("NEW MODE ARRIVED...");
    if(messageTemp=="TurnLightOn") {
      lightControlMode = 1;
      client.publish("home/garage/esp1/light/status", "Armed");
      client.publish("home/garage/esp1/light/mode", "Light on");
      Serial.print("Light control status: LIGHT ON");
    } else if(messageTemp=="TurnLightOff") {
      lightControlMode = 2;
      client.publish("home/garage/esp1/light/status", "Armed");
      client.publish("home/garage/esp1/light/mode", "Light off");
      Serial.print("Light control status: LIGHT OFF");
    } else if(messageTemp=="ControlByLight") {
      lightControlMode = 0;
      client.publish("home/garage/esp1/light/status", "Armed");
      client.publish("home/garage/esp1/light/mode", "Control by light");
      Serial.print("Light control status: CONTROL BY LIGHT");
    }
  }

  if(topic=="home/garage/esp1/light/threshold") {
    Serial.print("NEW THRESHOLD ARRIVED...");
    Serial.print(messageTemp);

    lightThreshold = atoi(messageTemp.c_str());
  }
 
  Serial.println();
}

void report_motion_status(String messageTemp)
{
  if(messageTemp == "1"){
    Serial.print("Motion Sensor Armed");
    client.publish("home/garage/esp1/motion/status", "Armed");
    client.publish("home/garage/esp1/motion/notification", "NO MOTION");
    armMotion = true;
    motionTriggered = false;
  } else if(messageTemp == "0"){
    Serial.print("Motion Sensor Not Armed");
    client.publish("home/garage/esp1/motion/status", "Not Armed");
    client.publish("home/garage/esp1/motion/notification", "NO MOTION");
    armMotion=false;
    motionTriggered = false;
    digitalWrite(motionLED, LOW);
  }
}

void report_smoke_status(boolean smokeTriggered)
{
  client.publish("home/garage/esp1/smoke/notification", "NOT AVAILABLE");
  return;
  
  if (smokeTriggered) {
    client.publish("home/garage/esp1/smoke/notification", "SMOKE DETECTED!!!");
    Serial.println("SMOKE DETECTED!!!");
  }
  else
  {
    // Not in test mode
    client.publish("home/garage/esp1/smoke/notification", "NO SMOKE");
    Serial.println("NO SMOKE");
  }
}
