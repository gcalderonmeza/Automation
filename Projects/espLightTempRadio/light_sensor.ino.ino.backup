boolean reconnectedFlag = false;

// This functions reconnects your ESP8266 to your MQTT broker
// Change the function below if you want to subscribe to more topics with your ESP8266
void check_connection() {
    // Loop until we're reconnected
  if (!client.connected()) {
    Serial.print("Attempting MQTT connection...");
    // Attempt to connect
    if (client.connect("GarageESP8266Client")) {
      Serial.println("connected");
      reconnectedFlag = true;

      // Publish "after reconnection states"
      // report_smoke_status(smokeTriggered);
      client.publish("home/garage/esp1/motion/status", armMotion ? "Armed" : "Not Armed");
      client.publish("home/garage/esp1/motion/notification", "NO MOTION");

      static char lightValTemp[6];
      //dtostrf(m, 6, 0, lightValTemp);
      itoa(lightThreshold, lightValTemp, 10);
      
      client.publish("home/garage/esp1/light/currentThreshold", lightValTemp);
      
      // Subscribe or resubscribe to topics
      client.subscribe("home/garage/esp1/switch");
      //client.subscribe("home/garage/esp1/workbench");
      client.subscribe("home/garage/esp1/smoke");
      client.subscribe("home/garage/esp1/motion");
      client.subscribe("home/garage/esp1/light");
      client.subscribe("home/garage/esp1/light/threshold");
      delay(100);
    } else {
      Serial.print("Error: failed, rc=");
      Serial.println(client.state());
      // Serial.println(" try again in 5 seconds");
      // Wait 5 seconds before retrying
      // delay(5000);
    }
  }
  else
  {
    reconnectedFlag = false;
  }
}

// Checks motion
// Do not publish anything to MQTT here, it breaks the whole connection
void detectsMovement() {
  if (armMotion) {
    if (!motionTriggered) {
      motionFirstTimeTriggered = true;
    }
    
    motionTriggered = true;
  }
}

// The setup function sets your ESP GPIOs to Outputs, starts the serial communication at a baud rate of 115200
// Sets your mqtt broker and sets the callback function
// The callback function is what receives messages and actually controls the LEDs
void setup() {
  //pinMode(smokeLED, OUTPUT);
  pinMode(motionLED, OUTPUT);
  //pinMode(buzzerPin, OUTPUT);
  pinMode(lightPin, INPUT);

  //pinMode(smokePin, INPUT);
  attachInterrupt(digitalPinToInterrupt(motionSensor), detectsMovement, RISING);
  
  dht.begin();
  Serial.begin(115200);
  setup_wifi();
  client.setServer(mqtt_server, 1883);
  client.setCallback(callback);

  //Setup the radio transmitter
  mySwitch.enableTransmit(16);
  mySwitch.setPulseLength(160);
  mySwitch.setProtocol(7);
  //mySwitch.setRepeatTransmit(15);
}

void processHumedityAndTemperature()
{
  // Sensor readings may also be up to 2 seconds 'old' (its a very slow sensor)
  float h = dht.readHumidity();
  // Read temperature as Celsius (the default)
  float t = dht.readTemperature();
  // Read temperature as Fahrenheit (isFahrenheit = true)
  // float f = dht.readTemperature(true);
  // Check if any reads failed and exit early (to try again).
  if (isnan(h) || isnan(t)) { //|| isnan(f)) {
    Serial.println("Failed to read from DHT sensor!");
    return;
  }
  
  // Computes temperature values in Celsius
  float hic = dht.computeHeatIndex(t, h, false);
  static char temperatureTemp[6];
  dtostrf(hic, 6, 2, temperatureTemp);

  // Uncomment to compute temperature values in Fahrenheit
  //float hif = dht.computeHeatIndex(f, h);
  //static char temperatureTempF[6];
  //dtostrf(hif, 6, 2, temperatureTempF);
  static char humidityTemp[6];
  dtostrf(h, 6, 2, humidityTemp);

  // Publishes Temperature and Humidity values
  client.publish("home/garage/esp1/temperature", temperatureTemp);
  client.publish("home/garage/esp1/humedity", humidityTemp);
  Serial.print("Humidity: ");
  Serial.print(h);
  Serial.print(" %\t Temperature: ");
  Serial.print(t);
  //Serial.print(" *F ");
  //Serial.print(f);
  Serial.print(" *C\t Heat index: ");
  Serial.print(hic);
  Serial.println(" *C ");
  //Serial.print(hif);
  //Serial.println(" *F");
}

